# Copiá este archivo a .env y completá los valores. No subas .env al repositorio.

# MySQL (usado por docker-compose)
MYSQL_ROOT_PASSWORD=
DB_HOST=mysql_db
DB_PORT=3306
DB_NAME=football_db
DB_USER=football_api
DB_PASSWORD=

# Backend
PORT=3000

# Autenticación
# JWT_SECRET es obligatorio: generalo con
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
ADMIN_USER=admin
# Hash bcrypt de la clave del admin, entre comillas simples. Generalo con
#   docker compose exec backend node -e "console.log(require('bcrypt').hashSync('TU_CLAVE', 10))"
ADMIN_PASSWORD_HASH=

# Carpeta con los CSV para importar (commit 3)
CSV_DIR=./data

# Opcional: análisis con LangChain (punto extra, no es obligatorio)
GOOGLE_API_KEY=