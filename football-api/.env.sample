# Contrasena root de MySQL usada por docker-compose.
MYSQL_ROOT_PASSWORD=root

# Conexion del backend a MySQL (usar mysql_db dentro de Docker o localhost por fuera).
DB_HOST=mysql_db
DB_PORT=3306
DB_NAME=football_db
DB_USER=football_api
DB_PASSWORD=password

# Puerto en el que corre el servidor backend.
PORT=3000

# Credenciales de autenticacion y clave secreta para tokens JWT.
JWT_SECRET=
ADMIN_USER=
ADMIN_PASSWORD_HASH=

# Clave de API de Google Gemini para el analisis con LangChain.
GOOGLE_API_KEY=

# Carpeta donde se ubican los archivos CSV para importar datos.
CSV_DIR=./data